  <!-- simple inline script to handle checkout simulation & email message -->
  <script>
    (function() {
      const checkoutBtn = document.getElementById('checkoutBtn');
      const emailDiv = document.getElementById('emailConfirmation');
      const nameField = document.getElementById('nameInput');
      const contactField = document.getElementById('contactInput');
      const addressField = document.getElementById('addressInput');

      checkoutBtn.addEventListener('click', function(e) {
        e.preventDefault();  // prevent any form reload

        // Simulate gathering lead data
        const name = nameField.value.trim() || 'not provided';
        const contact = contactField.value.trim() || '0337-4740727';
        const address = addressField.value.trim() || 'not provided';

        // In a real environment, here you'd send to a backend.
        // For demo, show the email confirmation line and a preview.
        emailDiv.style.display = 'block';

        // Also we can show a quick summary (optional) as feedback
        alert(`✨ lead ready ✨\nname: ${name}\ncontact: ${contact}\naddress: ${address}\n\n(this info would be emailed to mariumijazali.110@gmail.com)`);

        // You could also dynamically fill hidden mailto, but spec says after checkout email of lead sent.
        // We mimic by showing message.
        console.log('lead data', { name, contact, address, to: 'mariumijazali.110@gmail.com' });
      });

      // if user clicks close panel, we can uncheck radio (optional, but toggles via label already)
      // add small extra: uncheck radio when close label clicked.
      const closeLabels = document.querySelectorAll('label[for="selectBBinary"]');
      closeLabels.forEach(label => {
        label.addEventListener('click', function() {
          document.getElementById('selectBBinary').checked = false;
        });
      });
    })();
  </script>
  <!-- Ensure the panel shows/hides based on radio (CSS active-panel) -->
  <style>
    /* we use .b-binary-selector:checked ~ .cart-side-panel */
    .b-binary-selector {
      display: none;
    }
    #selectBBinary:checked ~ .cart-side-panel {
      display: block !important;
    }
    /* but careful: the .cart-side-panel is sibling after input, which it is, good */
  </style>
  <!-- reorder for safety: input then panel in DOM -->
  <!-- the input is right before panel, so sibling selector works -->
</body>
